{
  "name": "dsh-agent-team-playbook",
  "version": "1.32.3",
  "description": "DeepSeek Harness plugin that brings an executable multi-agent collaboration workflow (charter, triage tiers, six-stage pipeline, audit gates, experience library): a read-only /agent-team command plus a collision-aware installer for the documents.",
  "type": "module",
  "license": "MIT",
  "author": "ChongCyrus",
  "homepage": "https://github.com/ChongCyrus/agent-team-playbook",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChongCyrus/agent-team-playbook.git"
  },
  "bin": {
    "dsh-agent-team-playbook": "./bin/cli.mjs"
  },
  "main": "lib/index.js",
  "files": [
    "client.js",
    "lib",
    "bin",
    "scripts",
    "cordis.patch.yml",
    "assets",
    "playbook",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "keywords": [
    "dsh-plugin",
    "dsh-bundle",
    "multi-agent",
    "workflow",
    "agents-md",
    "playbook",
    "dsh-command"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "scripts": {
    "sync": "node scripts/sync-playbook.mjs",
    "check": "node scripts/sync-playbook.mjs --check",
    "prepack": "node scripts/sync-playbook.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  }
}
